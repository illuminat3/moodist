{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build && node scripts/bundle-daemon.mjs"
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/moodistd"],
    "resources": {
      "../../public/sounds/": "sounds/"
    },
    "shortDescription": "Ambient sounds for focus and calm",
    "category": "Music",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
